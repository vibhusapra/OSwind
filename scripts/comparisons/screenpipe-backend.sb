(version 1)
(allow default)
; This is a benchmark process boundary, not a product sandbox or a power mode.
(deny file-read* (subpath (param "USER_DIRECTORY")))
(allow file-read-metadata (subpath (param "USER_DIRECTORY")))
(allow file-read* (subpath (param "TASK_ROOT"))
    (literal (param "BINARY")) (literal (param "METAL")))
(deny file-write*)
(allow file-write* (subpath (param "TASK_ROOT")) (literal "/dev/null"))
(deny network*)
(allow network-inbound (local ip (param "API_ADDRESS")))
(allow network-outbound (remote ip (param "API_ADDRESS")))
(deny mach-lookup (global-name-regex #"^com\.apple\.(tccd|axserver|accessibility|iohideventsystem|securityd|secd|appleeventsd|CalendarAgent|eventkitd|addressbook.*|metadata).*"))
(deny appleevent-send)
